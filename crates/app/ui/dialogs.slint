import { Button, LineEdit, ComboBox, ScrollView, AboutSlint, Slider } from "std-widgets.slint";
import { Cols, Theme, ThemedWindow, BigTypeIcon, Glyph, HRow, CheckBox } from "common.slint";
import { Label, Hint, Section, Radio } from "dialog_controls.slint";
export { SettingsDialog } from "settings_dialog.slint";
export { SchedulerDialog, GrabberDialog } from "organizer_dialogs.slint";
export { TorrentDialog, PlaylistDialog } from "media_dialogs.slint";

// ------------------------------------------------------------------ View > Columns

export component ColumnsDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Columns");
    preferred-width: 320px;
    in-out property <Cols> cols;
    callback save();
    callback reset();
    callback cancel();
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Label {
            text: @tr("Show these columns in the download list:");
        }
        Text {
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: @tr("File Name (always shown)");
            color: Theme.muted;
            font-size: 12px * Theme.font-scale;
        }
        CheckBox {
            text: @tr("Q (queue number)");
            checked: root.cols.q;
            toggled => {
                root.cols.q = self.checked;
            }
        }
        CheckBox {
            text: @tr("Size");
            checked: root.cols.size;
            toggled => {
                root.cols.size = self.checked;
            }
        }
        CheckBox {
            text: @tr("Status");
            checked: root.cols.status;
            toggled => {
                root.cols.status = self.checked;
            }
        }
        CheckBox {
            text: @tr("Time left");
            checked: root.cols.eta;
            toggled => {
                root.cols.eta = self.checked;
            }
        }
        CheckBox {
            text: @tr("Transfer rate");
            checked: root.cols.speed;
            toggled => {
                root.cols.speed = self.checked;
            }
        }
        CheckBox {
            text: @tr("Last Try Date");
            checked: root.cols.last;
            toggled => {
                root.cols.last = self.checked;
            }
        }
        CheckBox {
            text: @tr("Description");
            checked: root.cols.desc;
            toggled => {
                root.cols.desc = self.checked;
            }
        }
        CheckBox {
            text: @tr("Date Added");
            checked: root.cols.added;
            toggled => {
                root.cols.added = self.checked;
            }
        }
        CheckBox {
            text: @tr("Save To");
            checked: root.cols.saveto;
            toggled => {
                root.cols.saveto = self.checked;
            }
        }
        CheckBox {
            text: @tr("Referer");
            checked: root.cols.referer;
            toggled => {
                root.cols.referer = self.checked;
            }
        }
        CheckBox {
            text: @tr("Parent Web Page");
            checked: root.cols.parent;
            toggled => {
                root.cols.parent = self.checked;
            }
        }
        HRow {
            spacing: 8px;
            padding-top: 8px;
            Button {
                text: @tr("Reset");
                clicked => {
                    root.reset();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("OK");
                primary: true;
                clicked => {
                    root.save();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ category properties

export component CategoryDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: root.is-new ? @tr("Add category") : @tr("Category properties");
    preferred-width: 520px;
    in property <bool> is-new;
    in property <bool> builtin;
    in-out property <string> name;
    in-out property <string> exts;
    in-out property <string> sites;
    in-out property <string> name-contains;
    in-out property <string> folder;
    in property <string> message;
    callback browse();
    callback save();
    callback cancel();
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        GridLayout {
            spacing: 8px;
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                text: @tr("Category name");
            }
            LineEdit {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                text <=> root.name;
                enabled: !root.builtin;
                placeholder-text: @tr("e.g. Courses");
            }
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 1;
                text: @tr("File types");
            }
            LineEdit {
                col: Theme.rtl ? 0 : 1;
                row: 1;
                text <=> root.exts;
                placeholder-text: @tr("mp4 mkv avi (separated by spaces)");
            }
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 2;
                text: @tr("Sites");
            }
            LineEdit {
                col: Theme.rtl ? 0 : 1;
                row: 2;
                text <=> root.sites;
                placeholder-text: @tr("udemy.com *.coursera.org (optional)");
            }
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 3;
                text: @tr("File name contains");
            }
            LineEdit {
                col: Theme.rtl ? 0 : 1;
                row: 3;
                text <=> root.name-contains;
                placeholder-text: @tr("Words or phrases, separated by ;");
            }
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 4;
                text: @tr("Save files to");
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 4;
                spacing: 6px;
                LineEdit {
                    text <=> root.folder;
                    horizontal-stretch: 1;
                    placeholder-text: @tr("automatic (Downloads\\{})", root.name);
                }
                Button {
                    text: "…";
                    clicked => {
                        root.browse();
                    }
                }
            }
        }
        Hint {
            text: @tr("Rules are checked by site, then file name, then extension. Matching files are saved to this category's folder.");
        }
        HRow {
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.message;
                color: Theme.err;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("OK");
                primary: true;
                clicked => {
                    root.save();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ Find (Ctrl+F)

export component FindDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Find file");
    preferred-width: 440px;
    in-out property <string> text;
    in-out property <bool> in-name: true;
    in-out property <bool> in-desc: true;
    in-out property <bool> in-address: false;
    in-out property <bool> match-case;
    in-out property <bool> whole;
    in property <string> message;
    callback find-next();
    callback close-window();
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HRow {
            spacing: 8px;
            Label {
                text: @tr("Find what");
            }
            LineEdit {
                text <=> root.text;
                horizontal-stretch: 1;
                accepted(t) => {
                    root.find-next();
                }
            }
        }
        Section {
            text: @tr("Look in");
        }
        CheckBox {
            text: @tr("File name");
            checked <=> root.in-name;
        }
        CheckBox {
            text: @tr("Description");
            checked <=> root.in-desc;
        }
        CheckBox {
            text: @tr("Address, referer and parent web page");
            checked <=> root.in-address;
        }
        HRow {
            spacing: 14px;
            CheckBox {
                text: @tr("Match case");
                checked <=> root.match-case;
            }
            CheckBox {
                text: @tr("Match whole string");
                checked <=> root.whole;
            }
        }
        HRow {
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.message;
                color: Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Find Next");
                primary: true;
                clicked => {
                    root.find-next();
                }
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ File properties

export component PropertiesDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("File Properties – {}", root.file-name);
    preferred-width: 600px;
    in property <string> file-name;
    in property <string> kind: "general";
    in property <string> ext;
    in property <string> type-text;
    in property <string> status;
    in property <string> size;
    in property <string> added;
    in property <string> last-try;
    in property <string> result;
    in property <bool> done;
    in-out property <string> save-to;
    in-out property <string> url;
    in-out property <string> referer;
    in-out property <string> description;
    in-out property <string> checksum;
    in-out property <bool> use-login;
    in-out property <string> user;
    in-out property <string> password;
    in property <string> message;
    callback browse();
    callback open-file();
    callback save();
    callback cancel();
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HRow {
            spacing: 14px;
            BigTypeIcon {
                kind: root.kind;
                ext: root.ext;
            }
            GridLayout {
                spacing-horizontal: 12px;
                spacing-vertical: 4px;
                horizontal-stretch: 1;
                Label {
                    col: Theme.rtl ? 1 : 0;
                    row: 0;
                    text: @tr("Type");
                    color: Theme.muted;
                }
                Label {
                    col: Theme.rtl ? 0 : 1;
                    row: 0;
                    text: root.type-text;
                }
                Label {
                    col: Theme.rtl ? 1 : 0;
                    row: 1;
                    text: @tr("Status");
                    color: Theme.muted;
                }
                Label {
                    col: Theme.rtl ? 0 : 1;
                    row: 1;
                    text: root.status;
                    color: root.done ? Theme.ok : Theme.text;
                }
                Label {
                    col: Theme.rtl ? 1 : 0;
                    row: 2;
                    text: @tr("Size");
                    color: Theme.muted;
                }
                Label {
                    col: Theme.rtl ? 0 : 1;
                    row: 2;
                    text: root.size;
                }
                Label {
                    col: Theme.rtl ? 1 : 0;
                    row: 3;
                    text: @tr("Date added");
                    color: Theme.muted;
                }
                Label {
                    col: Theme.rtl ? 0 : 1;
                    row: 3;
                    text: root.added;
                }
                Label {
                    col: Theme.rtl ? 1 : 0;
                    row: 4;
                    text: @tr("Last try date");
                    color: Theme.muted;
                }
                Label {
                    col: Theme.rtl ? 0 : 1;
                    row: 4;
                    text: root.last-try;
                }
            }
        }
        GridLayout {
            spacing: 8px;
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                text: @tr("Save To");
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                spacing: 6px;
                LineEdit {
                    text <=> root.save-to;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "…";
                    clicked => {
                        root.browse();
                    }
                }
            }
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 1;
                text: @tr("Address");
            }
            LineEdit {
                col: Theme.rtl ? 0 : 1;
                row: 1;
                text <=> root.url;
                enabled: !root.done;
            }
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 2;
                text: @tr("Referer");
            }
            LineEdit {
                col: Theme.rtl ? 0 : 1;
                row: 2;
                text <=> root.referer;
            }
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 3;
                text: @tr("Description");
            }
            LineEdit {
                col: Theme.rtl ? 0 : 1;
                row: 3;
                text <=> root.description;
            }
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 4;
                text: @tr("Checksum");
            }
            LineEdit {
                col: Theme.rtl ? 0 : 1;
                row: 4;
                placeholder-text: @tr("MD5 / SHA-1 / SHA-256 (optional)");
                text <=> root.checksum;
            }
        }
        CheckBox {
            text: @tr("Use authorization (server login)");
            checked <=> root.use-login;
        }
        if root.use-login: HRow {
            spacing: 8px;
            Label {
                text: @tr("Login");
            }
            LineEdit {
                text <=> root.user;
                horizontal-stretch: 1;
            }
            Label {
                text: @tr("Password");
            }
            LineEdit {
                text <=> root.password;
                input-type: InputType.password;
                horizontal-stretch: 1;
            }
        }
        if root.result != "": Rectangle {
            height: 32px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: @tr("Result: {}", root.result);
                vertical-alignment: center;
                overflow: elide;
                font-size: 11px * Theme.font-scale;
                color: root.done ? Theme.ok : Theme.err;
            }
        }
        GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 8px;
            Button {
                col: Theme.rtl ? 3 : 0;
                row: 0;
                text: @tr("Open");
                enabled: root.done;
                clicked => {
                    root.open-file();
                }
            }
            Text {
                col: Theme.rtl ? 2 : 1;
                row: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.message;
                color: Theme.err;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            Button {
                col: Theme.rtl ? 1 : 2;
                row: 0;
                text: @tr("OK");
                primary: true;
                clicked => {
                    root.save();
                }
            }
            Button {
                col: Theme.rtl ? 0 : 3;
                row: 0;
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ duplicate link

export component DuplicateDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Duplicate download link");
    preferred-width: 520px;
    in property <string> file-name;
    in property <string> existing-status;
    in-out property <int> choice: 1;
    in-out property <bool> remember;
    callback ok();
    callback cancel();
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Label {
            text: @tr("This address is already in the download list:");
        }
        Text {
            // a long name is cut ("…"), it never makes the window wider
            min-width: 0px;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.file-name + "  (" + root.existing-status + ")";
            font-weight: 600;
            color: Theme.accent;
            overflow: elide;
        }
        Rectangle {
            height: 4px;
        }
        Radio {
            text: @tr("Add it with a new name (numbered)");
            checked: root.choice == 1;
            clicked => {
                root.choice = 1;
            }
        }
        Radio {
            text: @tr("Add it and replace the old download (overwrite the file)");
            checked: root.choice == 2;
            clicked => {
                root.choice = 2;
            }
        }
        Radio {
            text: @tr("If it is finished show it, if not resume it");
            checked: root.choice == 3;
            clicked => {
                root.choice = 3;
            }
        }
        CheckBox {
            text: @tr("Remember my choice (Options > Downloads)");
            checked <=> root.remember;
        }
        HRow {
            alignment: end;
            spacing: 8px;
            Button {
                text: @tr("OK");
                primary: true;
                clicked => {
                    root.ok();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ yes / no question
// Our own window instead of a Windows message box: it stays in front of the
// download windows and never stops the program while it waits.
export component ConfirmDialog inherits ThemedWindow {
    title: root.heading;
    preferred-width: 440px;
    min-width: 340px;
    always-on-top: true;
    // always in front already; kept so every window can be brought forward the same way
    in property <bool> front;
    in property <string> heading;
    in property <string> text;
    // removing downloads: "delete the files too" and "don't ask again"
    in property <bool> removing;
    in-out property <bool> delete-files;
    in-out property <bool> dont-ask;
    callback answered(bool);
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.answered(false);
                return accept;
            }
            if (event.text == Key.Return) {
                root.answered(true);
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 18px;
            spacing: 14px;
            Label {
                text: root.text;
                wrap: word-wrap;
            }
            if root.removing: VerticalLayout {
                spacing: 6px;
                CheckBox {
                    text: @tr("Delete the downloaded files from the disk too (be careful)");
                    checked <=> root.delete-files;
                }
                CheckBox {
                    text: @tr("Don't show this question again");
                    checked <=> root.dont-ask;
                }
            }
            HRow {
                alignment: end;
                spacing: 8px;
                Button {
                    text: @tr("OK");
                    primary: true;
                    clicked => {
                        root.answered(true);
                    }
                }
                Button {
                    text: @tr("Cancel");
                    clicked => {
                        root.answered(false);
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ shut down / sleep countdown

export component CountdownDialog inherits ThemedWindow {
    title: @tr("Moo Downloader");
    preferred-width: 420px;
    always-on-top: true;
    // always in front already; kept so every window can be brought forward the same way
    in property <bool> front;
    in property <string> action-text: "shut down the computer";
    in property <int> seconds-left: 30;
    in property <int> seconds-total: 30;
    // a file still being put together: the time starts after it
    in property <string> waiting-text;
    callback now();
    callback stop();
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Text {
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: @tr("All downloads are finished.");
            font-size: 14px * Theme.font-scale;
            font-weight: 700;
            color: Theme.ok;
        }
        Label {
            text: @tr("Moo Downloader will {} in {} seconds.", root.action-text, root.seconds-left);
            wrap: word-wrap;
        }
        if root.waiting-text != "": Label {
            text: root.waiting-text;
            color: Theme.warn;
            wrap: word-wrap;
        }
        Rectangle {
            height: 10px;
            border-radius: 5px;
            background: Theme.bar-bg;
            Rectangle {
                x: Theme.rtl ? parent.width - self.width : 0;
                height: parent.height;
                border-radius: 5px;
                width: parent.width * (root.seconds-total > 0 ? root.seconds-left / root.seconds-total : 0);
                background: Theme.warn;
                animate width {
                    duration: 900ms;
                }
            }
        }
        HRow {
            alignment: end;
            spacing: 8px;
            Button {
                text: @tr("Now");
                clicked => {
                    root.now();
                }
            }
            Button {
                text: @tr("Stop");
                primary: true;
                clicked => {
                    root.stop();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ Tip of the day

export component TipDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Tip of the day");
    // a set size: a wrapped text that decides the window's size can make the
    // window measure itself again and again
    preferred-width: 480px;
    preferred-height: 210px;
    min-width: 420px;
    min-height: 200px;
    in property <string> tip;
    in property <string> counter;
    in-out property <bool> show-on-start: true;
    callback next();
    callback close-window();
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 14px;
            Rectangle {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: @linear-gradient(135deg, #8b5cf6 0%, #2563eb 100%);
                Glyph {
                    x: 10px;
                    y: 10px;
                    width: 24px;
                    height: 24px;
                    kind: "bulb";
                }
            }
            VerticalLayout {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Did you know…");
                    font-size: 14px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.tip;
                    wrap: word-wrap;
                    color: Theme.text;
                    font-size: 12px * Theme.font-scale;
                    vertical-stretch: 1;
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.counter;
                    color: Theme.muted;
                    font-size: 11px * Theme.font-scale;
                }
            }
        }
        HRow {
            spacing: 8px;
            CheckBox {
                text: @tr("Show tips at startup");
                checked <=> root.show-on-start;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Next tip");
                clicked => {
                    root.next();
                }
            }
            Button {
                text: @tr("Close");
                primary: true;
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ Refresh download address

export component RefreshDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Refresh download address");
    preferred-width: 520px;
    in property <string> file-name;
    in property <string> page;
    in property <bool> waiting: true;
    in-out property <string> new-url;
    callback open-page();
    callback use-url();
    callback stop-waiting();
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text {
            // a long name is cut ("…"), it never makes the window wider
            min-width: 0px;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.file-name;
            font-weight: 700;
            color: Theme.accent;
            overflow: elide;
        }
        Label {
            text: @tr("1. Open the web page where you got this file.\n2. Click the download link there again (or start the video).\n3. Moo Downloader takes the new address and continues from where it stopped.");
            wrap: word-wrap;
        }
        if root.page != "": HRow {
            spacing: 8px;
            Text {
                // a long name is cut ("…"), it never makes the window wider
                min-width: 0px;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.page;
                color: Theme.muted;
                font-size: 11px * Theme.font-scale;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: @tr("Open the page");
                clicked => {
                    root.open-page();
                }
            }
        }
        Hint {
            text: root.waiting ? @tr("Waiting for the new address from the browser…") : "";
        }
        Label {
            text: @tr("Or paste the new address here:");
        }
        HRow {
            spacing: 6px;
            LineEdit {
                text <=> root.new-url;
                horizontal-stretch: 1;
                placeholder-text: @tr("https://…");
            }
            Button {
                text: @tr("Use it");
                enabled: root.new-url != "";
                clicked => {
                    root.use-url();
                }
            }
        }
        HRow {
            alignment: end;
            Button {
                text: @tr("Stop waiting");
                clicked => {
                    root.stop-waiting();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ add the extension to a browser

export struct BrowserRow {
    name: string,
    // accent color of its card
    tint: color,
    installed: bool,
    // "Add from the store" / "Add (developer mode)"
    action: string,
}

component BrowserCard inherits Rectangle {
    in property <BrowserRow> data;
    callback add();
    height: 150px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ta.has-hover ? root.data.tint : Theme.line;
    background: ta.has-hover ? Theme.hover : Theme.panel;
    opacity: root.data.installed ? 1.0 : 0.55;
    ta := TouchArea {
        clicked => {
            root.add();
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        alignment: center;
        HRow {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 26px;
                background: @linear-gradient(135deg, root.data.tint 0%, root.data.tint.darker(40%) 100%);
                // a globe: the browser
                Path {
                    x: 10px;
                    y: 10px;
                    width: 32px;
                    height: 32px;
                    viewbox-width: 32;
                    viewbox-height: 32;
                    stroke: white;
                    stroke-width: 1.6px;
                    fill: transparent;
                    commands: "M 16 3 A 13 13 0 1 1 15.99 3 Z M 3 16 L 29 16 M 16 3 C 9 9 9 23 16 29 M 16 3 C 23 9 23 23 16 29";
                }
                Rectangle {
                    x: 34px;
                    y: 34px;
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: #2e9e4f;
                    border-width: 2px;
                    border-color: Theme.panel;
                    Glyph {
                        x: 2px;
                        y: 2px;
                        kind: "down";
                        tint: white;
                    }
                }
            }
        }
        Text {
            text: root.data.name;
            horizontal-alignment: center;
            font-size: 14px * Theme.font-scale;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: root.data.installed ? root.data.action : @tr("Not installed on this computer");
            horizontal-alignment: center;
            font-size: 11px * Theme.font-scale;
            color: root.data.installed ? Theme.accent : Theme.muted;
            wrap: word-wrap;
        }
    }
}

export component BrowserDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Add Moo Downloader to your browser");
    preferred-width: 880px;
    in property <[BrowserRow]> browsers;
    in property <string> steps;
    in property <string> folder;
    callback add(int);
    callback open-folder();
    callback copy-folder();
    callback repair();
    callback test-link();
    callback close-window();
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: @tr("Click your browser:");
            font-size: 14px * Theme.font-scale;
            font-weight: 700;
            color: Theme.text;
        }
        GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 12px;
            for b[i] in root.browsers: BrowserCard {
                col: Theme.rtl ? root.browsers.length - 1 - i : i;
                row: 0;
                horizontal-stretch: 1;
                data: b;
                add => {
                    root.add(i);
                }
            }
        }
        if root.steps != "": Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.accent;
            border-radius: 6px;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Section {
                    text: @tr("Almost done:");
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.steps;
                    wrap: word-wrap;
                    font-size: 12px * Theme.font-scale;
                    color: Theme.text;
                }
            }
        }
        HRow {
            spacing: 8px;
            Text {
                // a long name is cut ("…"), it never makes the window wider
                min-width: 0px;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.folder;
                font-size: 11px * Theme.font-scale;
                color: Theme.muted;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            // the add-in shows nothing / does not answer: its files are put
            // back and it starts again by itself
            Button {
                text: @tr("Test the link");
                clicked => {
                    root.test-link();
                }
            }
            Button {
                text: @tr("Repair the add-in");
                clicked => {
                    root.repair();
                }
            }
            Button {
                text: @tr("Copy folder path");
                clicked => {
                    root.copy-folder();
                }
            }
            Button {
                text: @tr("Open folder");
                clicked => {
                    root.open-folder();
                }
            }
            Button {
                text: @tr("Close");
                primary: true;
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ About

export component AboutDialog inherits ThemedWindow {
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("About Moo Downloader");
    preferred-width: 380px;
    in property <string> version;
    callback close-window();
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        HRow {
            alignment: center;
            Image {
                source: @image-url("icon.png");
                width: 72px;
                height: 72px;
            }
        }
        Text {
            text: "Moo Downloader";
            horizontal-alignment: center;
            font-size: 20px * Theme.font-scale;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: @tr("Version {}", root.version);
            horizontal-alignment: center;
            color: Theme.muted;
        }
        AboutSlint {
            preferred-height: 90px;
        }
        HRow {
            alignment: end;
            Button {
                text: @tr("Close");
                primary: true;
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

// "Download a part of a video": an address (video page, video link or
// stream), the quality, from / to, the kind of cut, a look at the part
// before it is downloaded; only the part is downloaded.
export component ClipDialog inherits ThemedWindow {
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download a part of a video");
    preferred-width: 640px;
    min-width: 520px;
    in-out property <string> url;
    in property <bool> busy;
    in property <string> status;
    in property <string> video-title;
    in property <[string]> qualities;
    in-out property <int> quality: 0;
    // seconds; 0 = the length is not known (type the times)
    in property <float> duration;
    in-out property <float> from: 0;
    in-out property <float> to: 0;
    in-out property <string> from-text;
    in-out property <string> to-text;
    in property <string> length-text;
    // 0 quick (the usual), 1 exact
    in-out property <int> cut: 0;
    in property <bool> previewing;
    in property <string> message;
    in property <bool> ready;
    callback fetch();
    callback from-typed(string);
    callback to-typed(string);
    callback slid();
    callback preview();
    callback download();
    callback close-window();
    property <length> label-w: 90px;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Label {
            text: @tr("Paste the address of the video (its page, or a link to the video or stream):");
        }
        HRow {
            spacing: 8px;
            LineEdit {
                text <=> root.url;
                placeholder-text: "https://…";
                horizontal-stretch: 1;
                accepted(t) => {
                    root.fetch();
                }
            }
            Button {
                text: root.busy ? @tr("Looking…") : @tr("Get the video");
                primary: !root.ready;
                enabled: !root.busy && root.url != "";
                clicked => {
                    root.fetch();
                }
            }
        }
        Text {
            min-width: 0px;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.status;
            font-size: 11px * Theme.font-scale;
            color: Theme.muted;
            overflow: elide;
        }
        if root.video-title != "": Text {
            min-width: 0px;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.video-title;
            font-size: 14px * Theme.font-scale;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
        HRow {
            spacing: 8px;
            Label {
                width: root.label-w;
                text: @tr("Quality:");
                vertical-alignment: center;
            }
            ComboBox {
                horizontal-stretch: 1;
                enabled: root.ready;
                model: root.qualities;
                current-index <=> root.quality;
            }
        }
        HRow {
            spacing: 8px;
            Label {
                width: root.label-w;
                text: @tr("From:");
                vertical-alignment: center;
            }
            LineEdit {
                width: 100px;
                enabled: root.ready;
                text <=> root.from-text;
                placeholder-text: "00:00";
                edited(t) => {
                    root.from-typed(t);
                }
            }
            Slider {
                horizontal-stretch: 1;
                enabled: root.ready && root.duration > 0;
                minimum: 0;
                maximum: max(root.duration, 1);
                value <=> root.from;
                changed(v) => {
                    root.slid();
                }
            }
        }
        HRow {
            spacing: 8px;
            Label {
                width: root.label-w;
                text: @tr("To:");
                vertical-alignment: center;
            }
            LineEdit {
                width: 100px;
                enabled: root.ready;
                text <=> root.to-text;
                placeholder-text: "00:30";
                edited(t) => {
                    root.to-typed(t);
                }
            }
            Slider {
                horizontal-stretch: 1;
                enabled: root.ready && root.duration > 0;
                minimum: 0;
                maximum: max(root.duration, 1);
                value <=> root.to;
                changed(v) => {
                    root.slid();
                }
            }
        }
        HRow {
            spacing: 8px;
            Label {
                width: root.label-w;
                text: @tr("Length:");
                vertical-alignment: center;
            }
            Text {
                vertical-alignment: center;
                text: root.length-text;
                color: Theme.text;
                font-weight: 700;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        HRow {
            spacing: 8px;
            Label {
                width: root.label-w;
                text: @tr("Cut:");
                vertical-alignment: center;
            }
            ComboBox {
                horizontal-stretch: 1;
                enabled: root.ready;
                model: [@tr("Quick cut (recommended)"), @tr("Exact cut")];
                current-index <=> root.cut;
            }
        }
        // what each kind of cut does
        Rectangle {
            background: Theme.input-bg;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.cut == 0 ? @tr("Quick cut") : @tr("Exact cut");
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    wrap: word-wrap;
                    color: Theme.text;
                    font-size: 12px * Theme.font-scale;
                    text: root.cut == 0
                        ? @tr("Takes seconds and keeps the quality exactly as it is (nothing is made again). A video can only start on a whole picture, so the part may start a second or two before the time you chose.")
                        : @tr("Starts and ends on the very second you chose. The picture of the part is made again, so it takes longer (about as long as the part plays, or less) and works the processor. Sound alone is always cut exactly.");
                }
            }
        }
        if root.message != "": Text {
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.message;
            wrap: word-wrap;
            color: #e0443b;
        }
        HRow {
            spacing: 8px;
            Button {
                text: root.previewing ? @tr("Preparing the preview…") : @tr("Preview the part");
                enabled: root.ready && !root.previewing;
                clicked => {
                    root.preview();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Download the part");
                primary: true;
                enabled: root.ready;
                clicked => {
                    root.download();
                }
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

// After an update: what is new, right to left in Arabic.
export component WhatsNewDialog inherits ThemedWindow {
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("What's new in Moo Downloader");
    preferred-width: 560px;
    preferred-height: 560px;
    min-width: 440px;
    min-height: 360px;
    in property <string> heading;
    in property <[string]> items;
    in property <bool> rtl;
    callback close-window();
    property <TextHorizontalAlignment> side: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            alignment: root.rtl ? end : start;
            if !root.rtl: Image {
                source: @image-url("icon.png");
                width: 40px;
                height: 40px;
            }
            Text {
                text: root.heading;
                font-size: 15px * Theme.font-scale;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-alignment: root.side;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            if root.rtl: Image {
                source: @image-url("icon.png");
                width: 40px;
                height: 40px;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            ScrollView {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: start;
                    for line in root.items: GridLayout {
                        // the dot on the side where the reading starts
                        spacing: 8px;
                        Text {
                            col: root.rtl ? 1 : 0;
                            row: 0;
                            text: "•";
                            color: Theme.accent;
                            font-weight: 700;
                        }
                        Text {
                            col: root.rtl ? 0 : 1;
                            row: 0;
                            text: line;
                            color: Theme.text;
                            wrap: word-wrap;
                            horizontal-alignment: root.side;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
        HRow {
            alignment: end;
            Button {
                text: @tr("OK");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

// Help > Check for updates: looks for a new version, says when
// this one is the newest, otherwise downloads the new one right here and
// installs it in front of the user.
export component UpdateDialog inherits ThemedWindow {
    // set for a moment so the window comes in front
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Check for updates");
    preferred-width: 460px;
    // 0 checking, 1 newest already, 2 downloading, 3 installing, 4 problem
    in property <int> state;
    in property <string> heading;
    in property <string> detail;
    // 0..1 while downloading (-1 = size unknown)
    in property <float> progress: -1;
    callback close-window();
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 14px;
            Rectangle {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: root.state == 1 ? Theme.ok : root.state == 4 ? Theme.err : Theme.accent;
                Glyph {
                    x: 14px;
                    y: 14px;
                    kind: root.state == 1 ? "check" : root.state == 4 ? "warn" : "down";
                    tint: white;
                }
            }
            VerticalLayout {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                alignment: center;
                spacing: 4px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.heading;
                    font-size: 14px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.detail;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        if root.state == 0 || root.state == 2 || root.state == 3: Rectangle {
            height: 10px;
            border-radius: 5px;
            background: Theme.bar-bg;
            clip: true;
            // known size: how far it is; otherwise a moving piece
            if root.state == 2 && root.progress >= 0: Rectangle {
                x: Theme.rtl ? parent.width - self.width : 0;
                width: parent.width * clamp(root.progress, 0, 1);
                height: parent.height;
                border-radius: 5px;
                background: Theme.accent;
                animate width { duration: 150ms; }
            }
            if !(root.state == 2 && root.progress >= 0): Rectangle {
                width: parent.width * 0.3;
                height: parent.height;
                border-radius: 5px;
                background: Theme.accent;
                x: mod(animation-tick() / 1ms, 1600) / 1600 * (parent.width * 1.3) - parent.width * 0.3;
            }
        }
        HRow {
            alignment: end;
            Button {
                text: root.state == 2 || root.state == 3 ? @tr("Hide") : @tr("Close");
                primary: root.state == 1 || root.state == 4;
                enabled: root.state != 3;
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}
