import { TabButton } from "download_dialogs.slint";
import { Button, LineEdit, SpinBox, ComboBox, ListView } from "std-widgets.slint";
import { SegView, TFileRow, TPeerRow, PieceRun, Theme, ThemedWindow, TypeIcon, BigTypeIcon, HeaderCell, Cell, HRow, CheckBox } from "common.slint";

// The per-download progress window (tabs like a classic download manager).
// A floating card of the 3D looks (the download window).
component DCard inherits Rectangle {
    border-radius: Theme.card-radius;
    background: @linear-gradient(180deg, Theme.card-top 0%, Theme.card-bottom 100%);
    border-width: 1px;
    border-color: Theme.card-line;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: Theme.look == 3 ? 3px : 2px;
    drop-shadow-color: Theme.card-shadow;
}

// One number of the download window in the 3D looks.
component StatCard inherits DCard {
    horizontal-stretch: 1;
    in property <string> label;
    in property <string> value;
    in property <color> tint: Theme.text;
    min-width: 0px;
    VerticalLayout {
        padding: 9px;
        padding-left: 11px;
        padding-right: 11px;
        spacing: 2px;
        Text {
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.label;
            font-size: 10.5px * Theme.font-scale;
            color: Theme.muted;
        }
        Text {
            min-width: 0px;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.value;
            font-size: 13px * Theme.font-scale;
            font-weight: 700;
            color: root.tint;
            overflow: elide;
        }
    }
}

export component DetailsDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: root.percent + " " + root.name;
    preferred-width: 500px;
    min-width: 440px;
    // the Windows title bar: a window drawn without it answered the mouse
    // in the wrong place on some Windows 10 / 11 computers

    in property <string> name;
    in property <string> percent;
    in property <string> url;
    in property <string> status;
    in property <string> size;
    in property <string> downloaded;
    in property <string> speed;
    in property <string> eta;
    in property <string> resumable;
    in property <bool> resumable-ok;
    in property <string> error;
    in property <string> kind: "general";
    in property <float> progress;
    // after the data: what it does now ("Joining…: 45%") and how far
    in property <string> step;
    in property <float> step-progress;
    in property <int> state;
    in property <[SegView]> segs;
    // the 3D looks: the progress ring and the speed of the last minute, as
    // drawings (made by the program)
    in property <string> ring-path;
    in property <string> speed-line;
    in property <string> speed-area;
    in-out property <bool> show-details: false;
    in-out property <int> tab: 0;
    // speed limiter tab
    in-out property <bool> limit-on;
    in-out property <int> limit-kb: 500;
    // options on completion tab
    in-out property <int> when-done: 0;
    in-out property <bool> complete-dialog: true;
    in-out property <bool> force-close;

    callback pause();
    callback resume();
    callback cancel-download();
    callback close-window();
    callback hide-to-tray();
    callback limit-changed();
    callback completion-changed();
    // "Hide details" / "Show details": the window takes the size it needs
    out property <length> content-height: outer.preferred-height;
    callback details-toggled();
    // a torrent: its files, people, trackers and pieces
    in property <bool> is-torrent;
    in property <[TFileRow]> t-files;
    in property <[TPeerRow]> t-peers;
    in property <[string]> t-trackers;
    in property <[PieceRun]> t-pieces;
    in property <string> t-summary;
    in-out property <int> t-view: 0;
    in-out property <bool> t-first-last;
    in-out property <string> t-new-tracker;
    in-out property <string> t-note;
    callback t-file-toggled(int);
    callback t-add-tracker();
    callback t-recheck();
    callback t-copy-magnet();
    callback t-first-last-changed();

    outer := VerticalLayout {
      padding: 0px;
      spacing: 0px;
      VerticalLayout {
        padding: 10px;
        spacing: 0px;
        HRow {
            spacing: 2px;
            TabButton {
                text: @tr("Download status");
                active: root.tab == 0;
                clicked => {
                    root.tab = 0;
                }
            }
            TabButton {
                text: @tr("Speed Limiter");
                active: root.tab == 1;
                clicked => {
                    root.tab = 1;
                }
            }
            TabButton {
                text: @tr("Options on completion");
                active: root.tab == 2;
                clicked => {
                    root.tab = 2;
                }
            }
            if root.is-torrent: TabButton {
                text: @tr("Torrent");
                active: root.tab == 3;
                clicked => {
                    root.tab = 3;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            background: Theme.depth && root.tab == 0 ? transparent : Theme.panel;
            border-width: Theme.depth && root.tab == 0 ? 0px : 1px;
            border-color: Theme.line;
            border-radius: Theme.depth ? Theme.card-radius : 0px;
            // its own size: a taller window gives the room to the connections
            vertical-stretch: root.show-details ? 0 : 1;
            // the 3D looks: the ring, the cards and the numbers
            min-height: Theme.depth && root.tab == 0 ? (root.error != "" ? 330px : 300px) * max(1, Theme.font-scale)
                : root.tab == 3 && root.is-torrent ? 330px * max(1, Theme.font-scale) : 150px;
            // nothing of a tab is ever drawn over the progress and the buttons
            clip: true;
            if root.tab == 0 && Theme.depth: VerticalLayout {
                padding: 10px;
                spacing: 10px;
                alignment: start;
                HRow {
                    spacing: 14px;
                    // how much is here, as a ring
                    Rectangle {
                        width: 150px;
                        height: 150px;
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            fill: transparent;
                            stroke: Theme.bar-bg;
                            stroke-width: 11px;
                            commands: "M 50 7 A 43 43 0 1 1 49.99 7";
                        }
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            fill: transparent;
                            stroke: @linear-gradient(135deg, Theme.bar-a 0%, Theme.bar-b 100%);
                            stroke-width: 11px;
                            commands: root.ring-path;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: root.percent;
                                horizontal-alignment: center;
                                font-size: 30px * Theme.font-scale;
                                font-weight: 800;
                                color: Theme.text;
                            }
                            Text {
                                text: root.speed;
                                horizontal-alignment: center;
                                font-size: 11px * Theme.font-scale;
                                color: Theme.muted;
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;
                        DCard {
                            HRow {
                                padding: 10px;
                                spacing: 10px;
                                Rectangle {
                                    width: 30px;
                                    TypeIcon {
                                        kind: root.kind;
                                        x: 3px;
                                        y: (parent.height - 22px) / 2;
                                        width: 22px;
                                        height: 22px;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        min-width: 0px;
                                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                        text: root.name;
                                        font-weight: 700;
                                        font-size: 13px * Theme.font-scale;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        min-width: 0px;
                                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                        text: root.url;
                                        font-size: 10.5px * Theme.font-scale;
                                        color: Theme.muted;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        // the speed of the last minute
                        DCard {
                            vertical-stretch: 1;
                            min-height: 84px;
                            Text {
                                x: Theme.rtl ? parent.width - self.width - 10px : 10px;
                                y: 6px;
                                text: @tr("Transfer rate");
                                font-size: 10.5px * Theme.font-scale;
                                color: Theme.muted;
                            }
                            Path {
                                x: 8px;
                                y: 22px;
                                width: parent.width - 16px;
                                height: parent.height - 28px;
                                viewbox-width: 200;
                                viewbox-height: 30;
                                fill: @linear-gradient(180deg, Theme.bar-a.transparentize(45%) 0%, Theme.bar-a.transparentize(100%) 100%);
                                stroke: transparent;
                                commands: root.speed-area;
                            }
                            Path {
                                x: 8px;
                                y: 22px;
                                width: parent.width - 16px;
                                height: parent.height - 28px;
                                viewbox-width: 200;
                                viewbox-height: 30;
                                fill: transparent;
                                stroke: Theme.bar-a;
                                stroke-width: 2px;
                                commands: root.speed-line;
                            }
                        }
                    }
                }
                GridLayout {
                    spacing: 8px;
                    StatCard {
                        row: 0;
                        col: Theme.rtl ? 2 : 0;
                        label: @tr("Status");
                        value: root.status;
                        tint: root.state == 4 ? Theme.err : Theme.text;
                    }
                    StatCard {
                        row: 0;
                        col: 1;
                        label: @tr("File size");
                        value: root.size;
                    }
                    StatCard {
                        row: 0;
                        col: Theme.rtl ? 0 : 2;
                        label: @tr("Downloaded");
                        value: root.downloaded;
                    }
                    StatCard {
                        row: 1;
                        col: Theme.rtl ? 2 : 0;
                        label: @tr("Transfer rate");
                        value: root.speed;
                    }
                    StatCard {
                        row: 1;
                        col: 1;
                        label: @tr("Time left");
                        value: root.eta;
                    }
                    StatCard {
                        row: 1;
                        col: Theme.rtl ? 0 : 2;
                        label: @tr("Resume capability");
                        value: root.resumable;
                        tint: root.resumable-ok ? Theme.ok : Theme.err;
                    }
                }
                if root.error != "": Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.error;
                    color: Theme.err;
                    wrap: word-wrap;
                    font-size: 11px * Theme.font-scale;
                }
            }
            if root.tab == 0 && !Theme.depth: VerticalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: start;
                HRow {
                    spacing: 8px;
                    TypeIcon {
                        kind: root.kind;
                        width: 20px;
                        height: 20px;
                    }
                    Text {
                        // a long name is cut ("…"), it never makes the window wider
                        min-width: 0px;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.url;
                        font-size: 11px * Theme.font-scale;
                        overflow: elide;
                        color: Theme.accent;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.grid;
                }
                VerticalLayout {
                    spacing: 2px;
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Status");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.status;
                            color: root.state == 4 ? Theme.err : Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("File size");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.size;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Downloaded");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.downloaded;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Transfer rate");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.speed;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Time left");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.eta;
                            color: Theme.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        Text {
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: @tr("Resume capability");
                            color: Theme.muted;
                            width: 115px;
                        }
                        Text {
                            // a long name is cut ("…"), it never makes the window wider
                            min-width: 0px;
                            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            text: root.resumable;
                            color: root.resumable-ok ? Theme.ok : Theme.err;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
                if root.error != "": Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.error;
                    color: Theme.err;
                    wrap: word-wrap;
                    font-size: 11px * Theme.font-scale;
                }
            }
            if root.tab == 1: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                HRow {
                    spacing: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Transfer rate");
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.speed;
                        color: Theme.text;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                CheckBox {
                    text: @tr("Use speed limiter for this download");
                    checked <=> root.limit-on;
                    toggled => {
                        root.limit-changed();
                    }
                }
                HRow {
                    spacing: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Maximum download speed (KB/s)");
                        color: root.limit-on ? Theme.text : Theme.muted;
                        vertical-alignment: center;
                    }
                    SpinBox {
                        width: 140px;
                        enabled: root.limit-on;
                        minimum: 1;
                        maximum: 1000000;
                        step-size: 50;
                        value <=> root.limit-kb;
                        edited(v) => {
                            root.limit-changed();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                HRow {
                    spacing: 6px;
                    for kb in [128, 256, 512, 1024, 2048, 5120]: Button {
                        text: kb >= 1024 ? @tr("{} MB/s", kb / 1024) : @tr("{} KB/s", kb);
                        clicked => {
                            root.limit-on = true;
                            root.limit-kb = kb;
                            root.limit-changed();
                        }
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Changes apply right away, even while downloading.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                }
            }
            if root.tab == 2: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("When this download completes:");
                    color: Theme.text;
                }
                ComboBox {
                    width: 300px;
                    model: [@tr("Do nothing (keep the computer on)"), @tr("Shut down the computer"), @tr("Sleep"), @tr("Exit Moo Downloader"), @tr("Hibernate")];
                    current-index <=> root.when-done;
                    selected(v) => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Force programs to close when shutting down");
                    checked <=> root.force-close;
                    enabled: root.when-done == 1;
                    toggled => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Show the \"Download complete\" window");
                    checked <=> root.complete-dialog;
                    toggled => {
                        root.completion-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("You get 30 seconds to cancel before the computer shuts down, sleeps or hibernates.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
            // ---- a torrent: its pieces, files, people and trackers
            if root.tab == 3 && root.is-torrent: VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.t-summary;
                    color: Theme.muted;
                    font-size: 11px * Theme.font-scale;
                }
                // which pieces are here
                Rectangle {
                    height: 12px;
                    background: Theme.bar-bg;
                    border-width: 1px;
                    border-color: Theme.line;
                    clip: true;
                    for run in root.t-pieces: Rectangle {
                        y: 0px;
                        height: parent.height;
                        x: (Theme.rtl ? 1 - run.to : run.from) * parent.width;
                        width: max(1px, (run.to - run.from) * parent.width);
                        background: run.here ? Theme.accent : transparent;
                    }
                }
                HRow {
                    spacing: 2px;
                    TabButton {
                        text: @tr("Files");
                        active: root.t-view == 0;
                        clicked => {
                            root.t-view = 0;
                        }
                    }
                    TabButton {
                        text: @tr("People");
                        active: root.t-view == 1;
                        clicked => {
                            root.t-view = 1;
                        }
                    }
                    TabButton {
                        text: @tr("Trackers");
                        active: root.t-view == 2;
                        clicked => {
                            root.t-view = 2;
                        }
                    }
                }
                if root.t-view == 0: ListView {
                    // the room that is left (a taller window: a longer list)
                    vertical-stretch: 1;
                    min-height: 96px;
                    for f[i] in root.t-files: HRow {
                        spacing: 8px;
                        padding: 2px;
                        CheckBox {
                            text: "";
                            checked: f.selected;
                            toggled => {
                                root.t-file-toggled(i);
                            }
                        }
                        Text {
                            text: f.name;
                            color: Theme.text;
                            overflow: elide;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: f.size;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Text {
                            text: round(f.done * 100) + "%";
                            color: Theme.muted;
                            vertical-alignment: center;
                            width: 44px;
                        }
                    }
                }
                if root.t-view == 1: ListView {
                    vertical-stretch: 1;
                    min-height: 96px;
                    for p in root.t-peers: HRow {
                        spacing: 8px;
                        padding: 2px;
                        Text {
                            text: p.address + (p.seeder ? "  ★" : "");
                            color: Theme.text;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            overflow: elide;
                        }
                        Text {
                            text: "↓ " + p.down;
                            color: Theme.muted;
                        }
                        Text {
                            text: "↑ " + p.up;
                            color: Theme.muted;
                        }
                        Text {
                            text: p.have;
                            color: Theme.muted;
                            width: p.have == "" ? 0px : 44px;
                        }
                    }
                }
                if root.t-view == 2: VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;
                    ListView {
                        vertical-stretch: 1;
                        min-height: 64px;
                        for tr in root.t-trackers: Text {
                            text: tr;
                            color: Theme.text;
                            overflow: elide;
                        }
                    }
                    HRow {
                        spacing: 6px;
                        LineEdit {
                            text <=> root.t-new-tracker;
                            placeholder-text: "udp://… / https://…";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: @tr("Add tracker");
                            clicked => {
                                root.t-add-tracker();
                            }
                        }
                    }
                }
                HRow {
                    spacing: 8px;
                    CheckBox {
                        text: @tr("First and last pieces first");
                        checked <=> root.t-first-last;
                        toggled => {
                            root.t-first-last-changed();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: @tr("Check the files again");
                        clicked => {
                            root.t-recheck();
                        }
                    }
                    Button {
                        text: @tr("Copy magnet link");
                        clicked => {
                            root.t-copy-magnet();
                        }
                    }
                }
                if root.t-note != "": Text {
                    text: root.t-note;
                    color: Theme.muted;
                    font-size: 11px * Theme.font-scale;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle {
            height: 8px;
        }
        Rectangle {
            height: Theme.depth ? 12px : 18px;
            border-width: Theme.depth ? 0px : 1px;
            border-color: Theme.line;
            border-radius: Theme.depth ? 6px : 0px;
            background: Theme.bar-bg;
            clip: true;
            Rectangle {
                x: Theme.rtl ? parent.width - 1px - self.width : 1px;
                y: 1px;
                height: parent.height - 2px;
                width: (parent.width - 2px) * root.progress;
                border-radius: Theme.depth ? 5px : 0px;
                background: Theme.depth ? @linear-gradient(90deg, Theme.bar-a 0%, Theme.bar-b 100%) : @linear-gradient(180deg, #4fd06a 0%, #1f9d3e 100%);
                animate width {
                    duration: 100ms;
                    easing: linear;
                }
            }
        }
        // the second bar: joining the picture and the sound, moving the file...
        if root.step != "": VerticalLayout {
            padding-top: 6px;
            spacing: 3px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.step;
                font-size: 11px * Theme.font-scale;
                color: Theme.text;
            }
            Rectangle {
                height: 12px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.bar-bg;
                clip: true;
                Rectangle {
                    x: Theme.rtl ? parent.width - 1px - self.width : 1px;
                    y: 1px;
                    height: parent.height - 2px;
                    width: (parent.width - 2px) * root.step-progress;
                    background: @linear-gradient(180deg, #5aa2ff 0%, #1d63d6 100%);
                    animate width {
                        duration: 250ms;
                        easing: linear;
                    }
                }
            }
        }
        Rectangle {
            height: 8px;
        }
        HRow {
            spacing: 8px;
            Button {
                text: root.show-details ? @tr("<< Hide details") : @tr("Show details >>");
                clicked => {
                    root.show-details = !root.show-details;
                    root.details-toggled();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            // the window goes, a small icon with the progress stays next to the clock
            if root.state != 3: Button {
                text: @tr("Next to the clock");
                clicked => {
                    root.hide-to-tray();
                }
            }
            if root.state == 0 || root.state == 1: Button {
                text: @tr("Pause");
                clicked => {
                    root.pause();
                }
            }
            if root.state == 2 || root.state == 4: Button {
                text: @tr("Resume");
                primary: true;
                clicked => {
                    root.resume();
                }
            }
            Button {
                text: root.state == 3 ? @tr("Close") : @tr("Cancel");
                clicked => {
                    if (root.state == 3) {
                        root.close-window();
                    } else {
                        root.cancel-download();
                    }
                }
            }
        }
        // a taller window gives its room to the list of connections (never
        // as empty space between the parts)
        if root.show-details: VerticalLayout {
            spacing: 6px;
            padding-top: 8px;
            vertical-stretch: 1;
            Text {
                vertical-stretch: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Start positions and download progress by connections");
                font-size: 11px * Theme.font-scale;
                color: Theme.muted;
            }
            Rectangle {
                height: 20px;
                vertical-stretch: 0;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.panel;
                clip: true;
                for s in root.segs: Rectangle {
                    x: Theme.rtl ? parent.width - 1px - (parent.width - 2px) * s.start - self.width : 1px + (parent.width - 2px) * s.start;
                    y: 1px;
                    width: (parent.width - 2px) * (s.done - s.start);
                    height: parent.height - 2px;
                    background: Theme.accent;
                    animate width {
                        duration: 100ms;
                        easing: linear;
                    }
                }
                for s in root.segs: Rectangle {
                    x: Theme.rtl ? parent.width - 2px - (parent.width - 2px) * s.start : 1px + (parent.width - 2px) * s.start;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Theme.err;
                }
            }
            Rectangle {
                min-height: 150px;
                vertical-stretch: 1;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 1px;
                    Rectangle {
                        height: 22px;
                        background: @linear-gradient(180deg, Theme.header-top 0%, Theme.header-bottom 100%);
                        HRow {
                            HeaderCell {
                                text: @tr("N.");
                                width: 34px;
                            }
                            HeaderCell {
                                text: @tr("Downloaded");
                                width: 110px;
                            }
                            HeaderCell {
                                text: @tr("Info");
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for s in root.segs: Rectangle {
                            height: 19px;
                            HRow {
                                Cell {
                                    text: s.number;
                                    width: 34px;
                                    horizontal-alignment: center;
                                }
                                Cell {
                                    text: " " + s.downloaded;
                                    width: 110px;
                                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                }
                                Cell {
                                    text: s.info;
                                    horizontal-stretch: 1;
                                    color: s.busy ? Theme.accent : Theme.muted;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
}

// The finished file's icon with "Drag me" under it: pulled with the mouse,
// the file goes where it is let go (the desktop, a folder, a chat, an
// editor…) as a copy; the file itself stays where it is.
component DragFile inherits Rectangle {
    in property <string> kind;
    in property <string> ext;
    callback drag-out();
    property <bool> gone;
    min-width: max(72px, col.min-width);
    min-height: col.min-height;
    border-radius: 6px;
    background: ta.pressed ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    border-width: ta.has-hover ? 1px : 0px;
    border-color: Theme.select-line;
    col := VerticalLayout {
        padding: 6px;
        spacing: 4px;
        alignment: start;
        BigTypeIcon {
            kind: root.kind;
            ext: root.ext;
        }
        HRow {
            alignment: center;
            spacing: 4px;
            // arrows to all four sides: "pull me"
            Rectangle {
                width: 14px;
                height: 14px;
                Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 14;
                    viewbox-height: 14;
                    stroke: Theme.accent;
                    stroke-width: 1.4px;
                    fill: transparent;
                    commands: "M 7 1 L 7 13 M 1 7 L 13 7 M 5 3 L 7 1 L 9 3 M 5 11 L 7 13 L 9 11 M 3 5 L 1 7 L 3 9 M 11 5 L 13 7 L 11 9";
                }
            }
            Text {
                text: @tr("Drag me");
                font-size: 11px * Theme.font-scale;
                color: Theme.accent;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.grab;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.gone = false;
            }
        }
        moved => {
            if (self.pressed && !root.gone && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px)) {
                root.gone = true;
                root.drag-out();
            }
        }
    }
}

export component CompleteDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download complete");
    preferred-width: 540px;

    in property <string> name;
    in property <string> size;
    in property <string> path;
    in property <string> url;
    in property <string> kind: "general";
    in property <string> ext;
    in-out property <bool> dont-show;

    callback open-file();
    callback open-with();
    callback open-folder();
    callback close-window();
    // the file pulled out of the window (onto the desktop, a folder, a chat…)
    callback drag-out();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 16px;
            DragFile {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                kind: root.kind;
                ext: root.ext;
                drag-out => {
                    root.drag-out();
                }
            }
            VerticalLayout {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Download complete");
                    font-size: 15px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.ok;
                }
                GridLayout {
                    spacing: 6px;
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 0;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Address");
                        color: Theme.muted;
                    }
                    Text {
                        // a long name is cut ("…"), it never makes the window wider
                        min-width: 0px;
                        col: Theme.rtl ? 0 : 1;
                        row: 0;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.url;
                        overflow: elide;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.accent;
                    }
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 1;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("File size");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 1;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.size;
                        color: Theme.text;
                    }
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 2;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Saved as");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 2;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.path;
                        wrap: word-wrap;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.text;
                    }
                }
            }
        }
        HRow {
            spacing: 8px;
            CheckBox {
                text: @tr("Don't show this again");
                checked <=> root.dont-show;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Open");
                primary: true;
                clicked => {
                    root.open-file();
                }
            }
            // no "Open with…" here: picked by mistake it changes which
            // program opens this kind of file (still in the list's menu)
            Button {
                text: @tr("Open folder");
                clicked => {
                    root.open-folder();
                }
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}
