                        root.set-language("ru");
                    }
                }
            }
            Menu {
                title: @tr("Theme");
                MenuItem {
                    title: (Theme.mode == 0 ? "● " : "○ ") + @tr("Light");
                    activated => {
                        root.set-theme(0);
                    }
                }
                MenuItem {
                    title: (Theme.mode == 1 ? "● " : "○ ") + @tr("Dark");
                    activated => {
                        root.set-theme(1);
                    }
                }
                MenuItem {
                    title: (Theme.mode == 2 ? "● " : "○ ") + @tr("Ocean blue");
                    activated => {
                        root.set-theme(2);
                    }
                }
                MenuItem {
                    title: (Theme.mode == 3 ? "● " : "○ ") + @tr("Midnight purple");
                    activated => {
                        root.set-theme(3);
                    }
                }
                MenuItem {
                    title: (Theme.mode == 4 ? "● " : "○ ") + @tr("Forest green");
                    activated => {
                        root.set-theme(4);
                    }
                }
                MenuItem {
                    title: (Theme.mode == 5 ? "● " : "○ ") + @tr("Black");
                    activated => {
                        root.set-theme(5);
                    }
                }
                MenuItem {
                    title: (Theme.mode == 6 ? "● " : "○ ") + @tr("Sunset");
                    activated => {
                        root.set-theme(6);
                    }
                }
                MenuItem {
                    title: (Theme.mode == 7 ? "● " : "○ ") + @tr("Teal night");
                    activated => {
                        root.set-theme(7);
                    }
                }
                MenuItem {
                    title: (Theme.mode == 8 ? "● " : "○ ") + @tr("Rose");
                    activated => {
