                }
                MenuItem {
                    title: (Theme.mode == 10 ? "● " : "○ ") + @tr("Aurora glass");
                    activated => {
                        root.set-theme(10);
                    }
                }
                MenuItem {
                    title: (Theme.mode == 11 ? "● " : "○ ") + @tr("Soft clay");
                    activated => {
