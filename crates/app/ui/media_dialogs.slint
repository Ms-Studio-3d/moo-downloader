import { Button, LineEdit, SpinBox, ComboBox, ListView } from "std-widgets.slint";
import { LinkRow, Theme, ThemedWindow, TypeIcon, HeaderCell, Cell, Glyph, HRow, CheckBox } from "common.slint";
import { Label } from "dialog_controls.slint";

// ------------------------------------------------------------------ torrents

export component TorrentDialog inherits ThemedWindow {
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Add a torrent");
    preferred-width: 700px;
    preferred-height: 540px;
    min-width: 560px;
    min-height: 420px;
    // a magnet link or the path of a .torrent file
    in-out property <string> source;
    in property <string> name;
    in property <string> info;
    in property <[LinkRow]> files;
    in-out property <string> folder;
    in-out property <bool> start-now: true;
    in property <string> checked-text;
    in property <string> message;
    in property <bool> magnet;
    callback pick-file();
    callback load();
    callback toggle(int);
    callback check-all(bool);
    callback browse();
    callback download();
    callback close-window();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Label {
            text: @tr("A magnet link, or a .torrent file:");
        }
        HRow {
            spacing: 8px;
            LineEdit {
                text <=> root.source;
                placeholder-text: @tr("magnet:?xt=urn:btih:…  or  C:\\…\\file.torrent");
                horizontal-stretch: 1;
                accepted(t) => {
                    root.load();
                }
                edited(t) => {
                    root.load();
                }
            }
            Button {
                text: @tr("Open .torrent file…");
                clicked => {
                    root.pick-file();
                }
            }
        }
        HRow {
            spacing: 10px;
            if root.name != "": TypeIcon {
                kind: "torrent";
                width: 32px;
                height: 32px;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    // a long name is cut ("…"), it never makes the window wider
                    min-width: 0px;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.name;
                    font-size: 14px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    // a long name is cut ("…"), it never makes the window wider
                    min-width: 0px;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: root.info;
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    overflow: elide;
                }
            }
        }
        HRow {
            spacing: 6px;
            visible: root.files.length > 1;
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Check all");
                clicked => {
                    root.check-all(true);
                }
            }
            Button {
                text: @tr("Uncheck all");
                clicked => {
                    root.check-all(false);
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: 22px;
                    background: @linear-gradient(180deg, Theme.header-top 0%, Theme.header-bottom 100%);
                    HRow {
                        HeaderCell {
                            text: "";
                            width: 34px;
                        }
                        HeaderCell {
                            text: @tr("File");
                            horizontal-stretch: 1;
                        }
                        HeaderCell {
                            text: @tr("Size");
                            width: 90px;
                        }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for f[i] in root.files: Rectangle {
                        height: 24px;
                        background: fa.has-hover ? Theme.hover : transparent;
                        fa := TouchArea {
                            clicked => {
                                root.toggle(i);
                            }
                        }
                        HRow {
                            padding-left: Theme.rtl ? (0px) : (8px);
                            padding-right: Theme.rtl ? (8px) : (0px);
                            spacing: 4px;
                            Rectangle {
                                width: 26px;
                                Rectangle {
                                    y: (parent.height - 14px) / 2;
                                    width: 14px;
                                    height: 14px;
                                    border-width: 1px;
                                    border-radius: 2px;
                                    border-color: f.checked ? Theme.accent : Theme.muted;
                                    background: f.checked ? Theme.accent : Theme.input-bg;
                                    if f.checked: Glyph {
                                        x: 1px;
                                        y: 1px;
                                        width: 12px;
                                        height: 12px;
                                        kind: "check";
                                        tint: white;
                                    }
                                }
                            }
                            Rectangle {
                                width: 16px;
                                TypeIcon {
                                    kind: f.kind;
                                    width: 16px;
                                    height: 16px;
                                    y: 4px;
                                }
                            }
                            Cell {
                                text: f.name;
                                horizontal-alignment: f.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                horizontal-stretch: 1;
                            }
                            Cell {
                                text: f.ext;
                                width: 86px;
                                color: Theme.muted;
                                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
                            }
                        }
                    }
                }
            }
            if root.files.length == 0: Text {
                y: 60px;
                width: parent.width - 40px;
                x: 20px;
                horizontal-alignment: center;
                wrap: word-wrap;
                text: root.magnet
                    ? @tr("A magnet link brings its file list from the other computers when it starts: all its files are downloaded.")
                    : @tr("Paste a magnet link or open a .torrent file: what it shares shows up here.");
                color: Theme.muted;
            }
        }
        GridLayout {
            spacing: 8px;
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                text: @tr("Save to");
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                spacing: 6px;
                LineEdit {
                    text <=> root.folder;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "…";
                    clicked => {
                        root.browse();
                    }
                }
            }
        }
        HRow {
            spacing: 10px;
            CheckBox {
                text: @tr("Start now");
                checked <=> root.start-now;
            }
            Text {
                // a long name is cut ("…"), it never makes the window wider
                min-width: 0px;
                text: root.message != "" ? root.message : root.checked-text;
                color: root.message != "" ? Theme.err : Theme.muted;
                vertical-alignment: center;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Button {
                text: @tr("Download");
                primary: true;
                enabled: root.name != "";
                clicked => {
                    root.download();
                }
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ YouTube playlist

export component PlaylistDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download a playlist");
    preferred-width: 780px;
    preferred-height: 600px;
    in-out property <string> url;
    in property <bool> busy;
    in property <string> status;
    in property <string> playlist-title;
    in property <[LinkRow]> entries;
    in-out property <int> quality: 0;
    in-out property <string> folder;
    in-out property <int> parallel: 2;
    in-out property <bool> numbered: true;
    in-out property <bool> start-now: true;
    // the videos' subtitles too (Options > Downloads, the same switch)
    in-out property <bool> subtitles;
    in property <string> checked-text;
    in property <string> message;
    callback fetch();
    callback toggle(int);
    callback check-all(bool);
    callback browse();
    callback download();
    callback close-window();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Label {
            text: @tr("Paste the address of a playlist:");
        }
        HRow {
            spacing: 8px;
            LineEdit {
                text <=> root.url;
                placeholder-text: @tr("https://…/playlist?list=…");
                horizontal-stretch: 1;
                accepted(t) => {
                    root.fetch();
                }
            }
            Button {
                text: root.busy ? @tr("Getting the list…") : @tr("Get videos");
                primary: true;
                enabled: !root.busy && root.url != "";
                clicked => {
                    root.fetch();
                }
            }
        }
        Text {
            // a long name is cut ("…"), it never makes the window wider
            min-width: 0px;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.status;
            font-size: 11px * Theme.font-scale;
            color: Theme.muted;
            overflow: elide;
        }
        if root.playlist-title != "": Text {
            // a long name is cut ("…"), it never makes the window wider
            min-width: 0px;
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            text: root.playlist-title;
            font-size: 14px * Theme.font-scale;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
        HRow {
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Check all");
                clicked => {
                    root.check-all(true);
                }
            }
            Button {
                text: @tr("Uncheck all");
                clicked => {
                    root.check-all(false);
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: 22px;
                    background: @linear-gradient(180deg, Theme.header-top 0%, Theme.header-bottom 100%);
                    HRow {
                        HeaderCell {
                            text: "";
                            width: 34px;
                        }
                        HeaderCell {
                            text: "#";
                            width: 40px;
                        }
                        HeaderCell {
                            text: @tr("Video");
                            horizontal-stretch: 1;
                        }
                        HeaderCell {
                            text: @tr("Length");
                            width: 80px;
                        }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for e[i] in root.entries: Rectangle {
                        height: 24px;
                        background: ea.has-hover ? Theme.hover : transparent;
                        ea := TouchArea {
                            clicked => {
                                root.toggle(i);
                            }
                        }
                        HRow {
                            padding-left: Theme.rtl ? (0px) : (8px);
                            padding-right: Theme.rtl ? (8px) : (0px);
                            spacing: 4px;
                            Rectangle {
                                width: 26px;
                                Rectangle {
                                    y: (parent.height - 14px) / 2;
                                    width: 14px;
                                    height: 14px;
                                    border-width: 1px;
                                    border-radius: 2px;
                                    border-color: e.checked ? Theme.accent : Theme.muted;
                                    background: e.checked ? Theme.accent : Theme.input-bg;
                                    if e.checked: Glyph {
                                        x: 1px;
                                        y: 1px;
                                        width: 12px;
                                        height: 12px;
                                        kind: "check";
                                        tint: white;
                                    }
                                }
                            }
                            Cell {
                                text: e.text;
                                width: 36px;
                                color: Theme.muted;
                            }
                            Cell {
                                text: e.name;
                                horizontal-alignment: e.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                horizontal-stretch: 1;
                            }
                            Cell {
                                text: e.ext;
                                width: 76px;
                                color: Theme.muted;
                                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
                            }
                        }
                    }
                }
            }
            if root.entries.length == 0: Text {
                y: 70px;
                width: parent.width;
                horizontal-alignment: center;
                text: root.busy ? @tr("Getting the videos of the playlist…") : @tr("The videos of the playlist show up here.");
                color: Theme.muted;
            }
        }
        GridLayout {
            spacing: 8px;
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                text: @tr("Quality");
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                spacing: 8px;
                ComboBox {
                    width: 240px;
                    model: [@tr("Best quality (MP4)"), @tr("2160p 4K"), @tr("1440p 2K"), @tr("1080p Full HD"), @tr("720p HD"), @tr("480p SD"), @tr("360p SD"), "240p", "144p", @tr("Audio only (M4A)"), @tr("Audio MP3")];
                    current-index <=> root.quality;
                }
                Label {
                    text: @tr("Files at the same time");
                }
                SpinBox {
                    width: 90px;
                    minimum: 1;
                    // more at once and the site asks to confirm you are not a robot
                    maximum: 3;
                    value <=> root.parallel;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Label {
                col: Theme.rtl ? 1 : 0;
                row: 1;
                text: @tr("Save to");
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 1;
                spacing: 6px;
                LineEdit {
                    text <=> root.folder;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "…";
                    clicked => {
                        root.browse();
                    }
                }
            }
        }
        HRow {
            spacing: 10px;
            CheckBox {
                text: @tr("Number the files");
                checked <=> root.numbered;
            }
            CheckBox {
                text: @tr("Start now");
                checked <=> root.start-now;
            }
            CheckBox {
                text: @tr("Subtitles too");
                checked <=> root.subtitles;
            }
            Text {
                text: root.message != "" ? root.message : root.checked-text;
                color: root.message != "" ? Theme.err : Theme.muted;
                vertical-alignment: center;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Download");
                primary: true;
                enabled: root.entries.length > 0;
                clicked => {
                    root.download();
                }
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}
