import { Button, LineEdit, SpinBox, ComboBox, TextEdit } from "std-widgets.slint";
import { Theme, ThemedWindow, BigTypeIcon, Glyph, HRow, CheckBox } from "common.slint";

// ------------------------------------------------------------------ dialogs

// "Download File Info" – shown for every new download.
export component AddDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download File Info");
    preferred-width: 640px;
    min-width: 540px;

    in-out property <string> url;
    // full path: folder + file name
    in-out property <string> save-as;
    in-out property <string> description;
    in-out property <string> checksum;
    in-out property <int> connections: 32;
    in-out property <int> category-index: 0;
    in-out property <bool> remember-path;
    in property <string> category-name: "General";
    in property <string> kind: "general";
    in property <string> ext;
    in property <string> size-text;
    in property <string> info;
    in property <bool> probing;
    in property <bool> info-error;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in property <[string]> category-names: ["General", "Compressed", "Documents", "Music", "Programs", "Video", "Images"];
    in-out property <bool> use-login;
    in-out property <string> user;
    in-out property <string> password;
    // a warning about the address (web page, duplicate...)
    in property <string> warning;
    // the server refused Moo Downloader: offer the browser instead
    in property <bool> can-use-browser;
    callback use-browser();

    callback check-url();
    callback category-changed(int);
    callback browse();
    callback start-now();
    callback later();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HRow {
            spacing: 14px;
            GridLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 0;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("URL");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 0;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.url;
                        placeholder-text: @tr("https://example.com/file");
                        horizontal-stretch: 1;
                        accepted(t) => {
                            root.check-url();
                        }
                    }
                    Button {
                        text: @tr("Check");
                        clicked => {
                            root.check-url();
                        }
                    }
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 1;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Category");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 1;
                    ComboBox {
                        width: 200px;
                        model: root.category-names;
                        current-index <=> root.category-index;
                        selected(v) => {
                            root.category-changed(root.category-index);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 2;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Save As");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 2;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.save-as;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "…";
                        clicked => {
                            root.browse();
                        }
                    }
                }
                Rectangle {
                    col: Theme.rtl ? 1 : 0;
                    row: 3;
                }
                CheckBox {
                    col: Theme.rtl ? 0 : 1;
                    row: 3;
                    text: @tr("Remember this path for \"{}\" category", root.category-name);
                    checked <=> root.remember-path;
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 4;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Description");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    col: Theme.rtl ? 0 : 1;
                    row: 4;
                    text <=> root.description;
                    placeholder-text: @tr("optional note");
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 5;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Checksum");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    col: Theme.rtl ? 0 : 1;
                    row: 5;
                    text <=> root.checksum;
                    placeholder-text: @tr("MD5 / SHA-1 / SHA-256 (optional)");
                }
            }
            VerticalLayout {
                width: 110px;
                spacing: 6px;
                alignment: start;
                padding-top: 4px;
                BigTypeIcon {
                    kind: root.kind;
                    ext: root.ext;
                }
                Text {
                    text: root.size-text;
                    horizontal-alignment: center;
                    font-size: 12px * Theme.font-scale;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
        HRow {
            spacing: 8px;
            CheckBox {
                text: @tr("Use authorization");
                checked <=> root.use-login;
            }
            if root.use-login: Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Login");
                vertical-alignment: center;
                color: Theme.text;
            }
            if root.use-login: LineEdit {
                text <=> root.user;
                horizontal-stretch: 1;
            }
            if root.use-login: Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Password");
                vertical-alignment: center;
                color: Theme.text;
            }
            if root.use-login: LineEdit {
                text <=> root.password;
                input-type: InputType.password;
                horizontal-stretch: 1;
            }
            if !root.use-login: Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.warning != "": GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 6px;
            Glyph {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                kind: "warn";
            }
            Text {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.warning;
                color: Theme.warn;
                wrap: word-wrap;
                font-size: 12px * Theme.font-scale;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: 32px;
            border-width: 1px;
            border-color: root.info-error ? Theme.err : Theme.line;
            background: Theme.panel;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                vertical-alignment: center;
                text: root.probing ? @tr("Checking the address…") : root.info;
                color: root.info-error ? Theme.err : Theme.muted;
                overflow: elide;
                font-size: 12px * Theme.font-scale;
            }
        }
        HRow {
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Connections");
                vertical-alignment: center;
                color: Theme.text;
            }
            SpinBox {
                width: 110px;
                minimum: 1;
                maximum: 64;
                value <=> root.connections;
            }
            Rectangle {
                width: 10px;
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Queue");
                vertical-alignment: center;
                color: Theme.text;
            }
            ComboBox {
                model: root.queue-names;
                current-index <=> root.queue-index;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        HRow {
            spacing: 8px;
            alignment: end;
            if root.can-use-browser: Button {
                text: @tr("Download with the browser");
                clicked => {
                    root.use-browser();
                }
            }
            if root.can-use-browser: Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Download Later");
                enabled: root.url != "";
                clicked => {
                    root.later();
                }
            }
            Button {
                text: @tr("Start Download");
                primary: true;
                enabled: root.url != "";
                clicked => {
                    root.start-now();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 26px;
    width: label.preferred-width + 24px;
    background: root.active ? Theme.panel : ta.has-hover ? Theme.hover : Theme.window;
    border-width: 1px;
    border-color: Theme.line;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        font-weight: root.active ? 600 : 400;
        color: Theme.text;
    }
    if root.active: Rectangle {
        x: 1px;
        y: parent.height - 1px;
        width: parent.width - 2px;
        height: 2px;
        background: Theme.panel;
    }
}

export component BatchDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Add batch download");
    preferred-width: 640px;
    preferred-height: 520px;

    // 0: list of links, 1: address with a * pattern
    in-out property <int> mode: 0;
    in-out property <string> links;
    in-out property <string> folder;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in-out property <bool> start-now: true;
    in property <string> message;
    // pattern
    in-out property <string> pattern;
    in-out property <bool> letters;
    in-out property <string> from-text: "1";
    in-out property <string> to-text: "10";
    in-out property <int> wildcard-size: 1;
    in-out property <string> user;
    in-out property <string> password;
    in property <string> preview;

    callback paste();
    callback browse();
    callback pattern-changed();
    callback ok();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HRow {
            spacing: 2px;
            TabButton {
                text: @tr("List of links");
                active: root.mode == 0;
                clicked => {
                    root.mode = 0;
                }
            }
            TabButton {
                text: @tr("Address with a pattern (*)");
                active: root.mode == 1;
                clicked => {
                    root.mode = 1;
                    root.pattern-changed();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.mode == 0: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Paste the links, one per line. They download one after another in the queue you choose.");
                wrap: word-wrap;
                color: Theme.text;
            }
            TextEdit {
                text <=> root.links;
                vertical-stretch: 1;
                min-height: 200px;
                font-size: 12px * Theme.font-scale;
            }
            HRow {
                spacing: 6px;
                Button {
                    text: @tr("Paste from clipboard");
                    clicked => {
                        root.paste();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
        if root.mode == 1: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Type an address with a * where the number (or letter) goes, for example\nhttps://www.site.com/pictures/img*.jpg");
                wrap: word-wrap;
                color: Theme.text;
            }
            LineEdit {
                text <=> root.pattern;
                placeholder-text: @tr("https://www.site.com/pictures/img*.jpg");
                edited(t) => {
                    root.pattern-changed();
                }
            }
            HRow {
                spacing: 16px;
                CheckBox {
                    text: @tr("Letters (a-z) instead of numbers");
                    checked <=> root.letters;
                    toggled => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            HRow {
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("From");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.from-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("To");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.to-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Wildcard size");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                SpinBox {
                    width: 90px;
                    minimum: 1;
                    maximum: 10;
                    value <=> root.wildcard-size;
                    edited(v) => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Wildcard size 3 makes 001, 002 … 010.");
                color: Theme.muted;
                font-size: 11px * Theme.font-scale;
            }
            HRow {
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Login");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.user;
                    placeholder-text: @tr("optional");
                    horizontal-stretch: 1;
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Password");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.password;
                    input-type: InputType.password;
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 80px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    text: root.preview;
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        GridLayout {
            spacing: 8px;
            Text {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Queue");
                vertical-alignment: center;
                color: Theme.text;
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                ComboBox {
                    model: root.queue-names;
                    current-index <=> root.queue-index;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                col: Theme.rtl ? 1 : 0;
                row: 1;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Save all to");
                vertical-alignment: center;
                color: Theme.text;
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 1;
                spacing: 6px;
                LineEdit {
                    text <=> root.folder;
                    placeholder-text: @tr("automatic (by file type)");
                    horizontal-stretch: 1;
                }
                Button {
                    text: "…";
                    clicked => {
                        root.browse();
                    }
                }
            }
        }
        CheckBox {
            text: @tr("Start the queue now");
            checked <=> root.start-now;
        }
        HRow {
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.message;
                color: Theme.err;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Add");
                primary: true;
                clicked => {
                    root.ok();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}
